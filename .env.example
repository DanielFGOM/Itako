# Local development
PORT=8080
MONGODB_URI=mongodb+srv://<usuario>:<contraseña>@<cluster>.mongodb.net/itako?appName=Cluster0
MONGODB_DATABASE=itako
JWT_SECRET=REEMPLAZA_ESTO_POR_UN_SECRETO_LARGO_Y_ALEATORIO
ITAKO_ADMIN_EMAIL=Itakotaqueria@gmail.com
# Prefer a bcrypt hash. If omitted, ITAKO_ADMIN_PASSWORD can be used only for first startup.
ITAKO_ADMIN_PASSWORD_HASH=
ITAKO_ADMIN_PASSWORD=
# Same-origin is used when the React UI is served by the Go server.
# For a separate frontend service, set this to its public origin.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
